    function weatherIcon(c) {
        c = String(c || "").toLowerCase()
        if (c.indexOf("thunder") >= 0) return storm
        if (c.indexOf("rain") >= 0 || c.indexOf("drizzle") >= 0 || c.indexOf("snow") >= 0) return rain
        if (c.indexOf("cloud") >= 0 || c.indexOf("mist") >= 0 || c.indexOf("fog") >= 0 || c.indexOf("haze") >= 0) return cloud
        return sun
    }

    function app(name) {
        name = String(name || "")
        if (name === "") return ""
        if (name.charAt(0) === "/") return "file://" + name
        var tries = [name, name.replace(/\.(png|svg|xpm)$/i, ""), name.toLowerCase(), "application-x-executable"]
        for (var i = 0; i < tries.length; i++) {
            try {
                var p = Quickshell.iconPath(tries[i], true)
                if (p) return p
            } catch (e) {}
        }
        return ""
    }
